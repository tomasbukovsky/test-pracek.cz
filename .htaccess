RewriteEngine On

# ---------------------------------------------------------------
# 1) Kanonická doména: vždy https + www
# ---------------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.test-pracek.cz/$1 [R=301,L]

# ---------------------------------------------------------------
# 2) sitemap.xml -> sitemap.php (URL zůstává bez přípony .php)
# ---------------------------------------------------------------
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ---------------------------------------------------------------
# 3) Přesměrování starých ročníkových URL na nový web (viz zadání 4.4)
#    Specifická pravidla VŽDY před obecným pravidlem níže.
#    Používáme RewriteRule (ne RedirectMatch z mod_alias) - míchání mod_alias
#    a mod_rewrite ve stejném .htaccess bývá nespolehlivé (pořadí vyhodnocení
#    mezi moduly není garantované), zatímco RewriteRule běží ve stejném
#    mod_rewrite kontextu jako pravidlo č. 1 výše.
# ---------------------------------------------------------------

# Podstránky ročníků (pokud by nějaké existovaly) — tematicky na odpovídající segment
# Příklad (odkomentovat a upravit, pokud se najde konkrétní stará URL):
# RewriteRule ^20[0-9]{2}/pracky-s-hornim-plnenim.*$ /pracky-s-hornim-plnenim/ [R=301,L]

# Kořeny ročníků /2013/ až /2022/ (a jakékoli budoucí) -> homepage, jeden skok
RewriteRule ^20[0-9]{2}/?$ / [R=301,L]

# ---------------------------------------------------------------
# 3b) Neexistující URL -> vlastní 404 šablona (místo výchozí stránky hostingu)
# ---------------------------------------------------------------
ErrorDocument 404 /404.php

# ---------------------------------------------------------------
# 4) Bezpečnostní hlavičky a výkon (volitelné, ale nic nekazí)
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
</IfModule>
